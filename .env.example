# Copy to `.env` and fill in. Every value here is NEXT_PUBLIC_*, meaning Next.js
# inlines it into the client bundle during `next build` — so these must be set in
# whatever environment runs the BUILD, not only on the running service.
#
# The build fails fast and names anything required that is missing; see the check
# in next.config.ts.

# Required. Privy rejects an empty or malformed id, and PrivyAppProvider wraps
# the whole (app) and (auth) route groups, so every prerendered page needs it.
NEXT_PUBLIC_PRIVY_APP_ID=

# Backend origin, e.g. https://backendneftwerk-staging.up.railway.app
NEXT_PUBLIC_API_BASE_URL=

# Optional. Host for media, used to emit dns-prefetch/preconnect hints.
NEXT_PUBLIC_MEDIA_HOST=

# Optional. "testnet" or "public".
NEXT_PUBLIC_STELLAR_NETWORK=

# Optional. Shown in support requests so a report names the build it came from.
NEXT_PUBLIC_APP_ENV=
NEXT_PUBLIC_APP_VERSION=
